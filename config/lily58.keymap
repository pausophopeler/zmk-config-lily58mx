#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define default_layer 0
#define lower_layer 1
#define raise_layer 2
#define adjust_layer 3
#define extra_layer 4
#define f_layer 5

/ {
    behaviors {
        td_lbkt_copy: tap_dance_lbkt_copy {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBKT>, <&kp LG(C)>;
        };

        td_rbkt_paste: tap_dance_rbkt_paste {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RBKT>, <&kp LG(V)>;
        };

        eq_plus: eq_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp LS(EQUAL)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        new_line_below: new_line_below {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT)>, <&kp RET>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <lower_layer raise_layer>;
            then-layer = <adjust_layer>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  [/CPY |  |]/PST  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | BSPC | RAISE | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                          &kp N6          &kp N7    &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                                           &kp Y           &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LCTRL  &kp A   &kp S   &kp D     &lt f_layer F  &kp G                                           &kp H           &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B            &td_lbkt_copy  &td_rbkt_paste  &kp N           &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                            &kp LALT  &kp LGUI  &mo lower_layer  &kp SPACE      &kp RET         &kp BSPC        &mo raise_layer  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Lower";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |UNLCK |       |       |      | CAPS  |  INS  |
            // |   (   |  )  |  {  |  }   |  [   |  ]   |                   |  F7  |   7   |   8   |   9  |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |   4   |   5   |  6   |⌃⌥⌘, |   ~   |
            // |       |  =  |  +  |  -   |  \   | ⌥F1  |        |  |        |  0   |   1   |   2   |  3   |⌃⌥⌘M |  "|"  |
            //                     |      |      |      |        |  |        |      |  DEL  |       |

            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &studio_unlock  &trans   &trans  &trans  &caps_word  &eq_plus
&kp LPAR  &kp RPAR    &kp LBRC      &kp RBRC       &kp LBKT      &kp RBKT                        &kp F7          &kp N7   &kp N8  &kp N9  &kp F11     &kp F12
&kp GRAVE &kp EXCL    &kp AT        &kp HASH       &kp DOLLAR    &kp PRCNT                       &kp CARET       &kp N4   &kp N5  &kp N6  &kp LC(LA(LG(COMMA)))  &kp TILDE
&trans    &kp EQUAL   &kp KP_PLUS   &kp MINUS      &kp BSLH      &kp LS(F1)    &trans    &trans  &kp N0          &kp N1   &kp N2  &kp N3  &kp LC(LA(LG(M)))      &kp PIPE
                                                     &trans             &trans        &trans        &trans    &trans  &kp DEL         &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Raise";

            // Navigation cluster (right side) — same column = same direction, further from home = bigger scope:
            // Col:       [outer]   [ ← ]    [ ↓ ]    [ ↑ ]    [ → ]  [edit]
            // ------------------------------------------------------------------------------------------------------------
            // |       | BRI- | BRI+ |      |      |      |                   |       | ⇧⌥←  |       |       | ⇧⌥→  |^SPC  |
            // | MUTE  | VOL- | VOL+ | PREV | PLAY | NEXT |                   |       |  ⌥←  | PGDN  | PGUP  |  ⌥→  |BSPC  |
            // |   F1  |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  ⇧⌘← |   ←  |   ↓   |   ↑   |   →  | ⇧⌘→  |
            // |   F7  |  F8  |  F9  | F10  | F11  | F12  |        |  |       |       |  ⌘←  |  ⌘↓   |  ⌘↑   |  ⌘→  | DEL  |
            //                       |      |      |      |        |  |       |       | DEL  |       |

            bindings = <
&trans      &kp C_BRI_DN  &kp C_BRI_UP  &trans      &trans    &trans                      &trans            &kp LS(LA(LEFT))  &trans       &trans      &kp LS(LA(RIGHT))  &kp LC(SPACE)
&kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_PP  &kp C_NEXT                  &trans            &kp LA(LEFT)      &kp PG_DN    &kp PG_UP   &kp LA(RIGHT)      &kp DEL
&kp F1      &kp F2        &kp F3        &kp F4      &kp F5    &kp F6                      &kp LS(LG(LEFT))  &kp LEFT          &kp DOWN     &kp UP      &kp RIGHT          &kp LS(LG(RIGHT))
&kp F7      &kp F8        &kp F9        &kp F10     &kp F11   &kp F12  &trans    &trans   &trans            &kp LG(LEFT)      &kp LG(DOWN) &kp LG(UP)  &kp LG(RIGHT)      &kp BSPC
                                        &trans      &trans    &trans   &trans    &trans   &kp DEL           &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            display-name = "Adjust";

            // ------------------------------------------------------------------------------------------------------------
            // |       | BTCLR|     |      |      |      |                   | NL↓  | MSCTL | LOCK  | EMOJI |  ESC  | SPOT |
            // | BT_NXT|BT_PRV| CAPS|      |      |      |                   |PTAB  | NTAB  | NEWTB | CLOSE |REOPEN | ADDR |
            // |       |     |     | ZMOUT|      |      |                   |      |       | ZMIN  |       |       |      |
            // |       |     |     |      |      |      |EX ON   |EX OFF |      |       |       |       |       |      |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans     &bt BT_CLR_ALL  &trans      &trans              &trans  &trans                    &new_line_below    &kp LC(UP)        &kp LG(LC(Q))      &kp LC(LG(SPACE))  &kp ESC        &kp LG(SPACE)
&bt BT_NXT &bt BT_PRV      &caps_word  &trans              &trans  &trans                    &kp LS(LC(TAB))    &kp LC(TAB)       &kp LG(T)          &kp LG(W)          &kp LS(LG(T))  &kp LG(L)
&trans     &trans          &trans      &kp LG(LS(MINUS))  &trans  &trans                    &trans             &trans            &kp LG(LS(EQUAL))  &trans             &trans         &trans
&trans     &trans          &trans      &trans              &trans  &trans  &tog extra_layer    &tog extra_layer  &trans             &trans            &trans             &trans             &trans         &trans
                           &trans      &trans              &trans  &trans  &trans    &trans             &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        f_layer {
            display-name = "F-Nav";

            // Navigation grid — hold F to activate, columns 7-0 only
            // Key:  [7]            [8]          [9]          [0]
            // Num:  ⇧⌘←             ↑            ↓           ⇧⌘→
            // 2nd:  ⇧⌥←            ⇧⌥↑          ⇧⌥↓          ⇧⌥→
            // 3rd:  ⌥←              ⌥↑           ⌥↓           ⌥→
            // Bot:  ⌘←              ⌘↓           ⌘↑           ⌘→

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LS(LG(LEFT))   &kp UP          &kp DOWN        &kp LS(LG(RIGHT))   &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LS(LA(LEFT))   &kp LS(LA(UP))  &kp LS(LA(DOWN))  &kp LS(LA(RIGHT)) &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LA(LEFT)       &kp LA(UP)      &kp LA(DOWN)    &kp LA(RIGHT)       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &kp LG(LEFT)       &kp LG(DOWN)    &kp LG(UP)      &kp LG(RIGHT)       &trans
                        &trans  &trans  &trans  &trans   &trans   &trans  &trans              &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&tog extra_layer  &trans          &trans          &trans           &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans          &mmv MOVE_UP    &trans           &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &msc SCRL_DOWN                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &trans  &msc SCRL_UP    &mkp LCLK    &trans     &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans           &trans  &trans          &mkp LCLK    &mkp RCLK  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
